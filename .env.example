# Copy this file to .env for local Docker Compose runs.
# Never commit the real .env file. It is git-ignored on purpose.
#
# Everything here is optional. `docker compose run --rm mock` needs none of it.

# --- Read-only path ------------------------------------------------------
# An API key is an accepted caller identity for reading a PUBLIC live chat,
# and for nothing else. No OAuth consent screen, no browser, no login.
# It travels in a query string, so treat it as a bearer secret.
YC_YOUTUBE_API_KEY=your_api_key_here

# --- Full path -----------------------------------------------------------
# An OAuth client of type "Desktop app" from the Google Cloud console.
# The client SECRET is optional: an installed app authenticates with PKCE,
# so set it only if your client was issued one and refresh needs it.
YC_GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
YC_GOOGLE_CLIENT_SECRET=

# Tokens. Prefer `yc login` on the host and mounting ~/.config/yc instead of
# putting these here at all.
YC_GOOGLE_ACCESS_TOKEN=
YC_GOOGLE_REFRESH_TOKEN=

# Your own channel. Normally resolved from the token; this is only a fallback.
YC_YOUTUBE_CHANNEL_ID=

# --- Compose convenience -------------------------------------------------
# The chat opened by `docker compose run --rm live`. A video ID, a watch/live/
# shorts URL, a youtu.be link, an @handle, or a channel ID.
YC_CHAT_TARGET=dQw4w9WgXcQ

# --- Optional feature modes ---------------------------------------------
YC_THEME_NAME=claude
YC_ANIMATION_MODE=fast
YC_MESSAGE_LAYOUT=inline

# --- Optional quota controls --------------------------------------------
# The YouTube Data API grants 10,000 units/day, resetting at midnight Pacific.
# Reading chat at YouTube's advised cadence exhausts that in under three hours,
# so yc stretches its poll interval to make the budget last. See docs/quota.md.
YC_POLL_INTERVAL_MODE=auto
YC_QUOTA_RESERVE_PERCENT=10
# Budget to the next N hours instead of to the reset. 0 budgets to the reset.
YC_SESSION_HOURS=0
# Set to true only if your Google Cloud project has a raised quota.
YC_FOLLOW_SERVER_CADENCE=false

# --- Diagnostics ---------------------------------------------------------
# Redacted JSON-line logs. Review before sharing: they contain no credentials
# but can contain video IDs, chat IDs, channel names, and hostnames.
YC_DEBUG_LOG=false
