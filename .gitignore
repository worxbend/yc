.gomodcache/

# --- Site build output ---
# scripts/build-site.sh assembles _site/ from site/ plus a mirror of
# docs/assets/screenshots/. site/ is the tracked source; _site/ is generated
# and is what .github/workflows/pages.yml rebuilds on the runner. The mirrored
# screenshots under site/assets/screenshots/ are ignored by site/assets/.gitignore,
# next to what they cover.
/_site/

# --- Build / logs / temp ---
*.log
tmp/
temp/
.cache/
