# --- Credentials / local state ---
# yc writes credentials.json and the estimated quota ledger under the platform
# config and cache directories, but an isolated XDG_* run or a Docker bind mount
# can land them in the working tree.
credentials.json
*credentials*.json
config.toml
.local/
quota/

# --- Go build output ---
/yc
/bin/
/dist/
/build/
/out/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.prof
*.pprof
